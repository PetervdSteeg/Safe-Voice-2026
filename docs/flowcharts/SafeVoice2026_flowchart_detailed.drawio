elBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c153" target="c154"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c178" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c153" target="c155"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c179" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#9673a6;endArrow=open;" edge="1" parent="1" source="c155" target="c156"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c180" value="TODO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;dashed=1;strokeColor=#9673a6;endArrow=open;" edge="1" parent="1" source="c155" target="c157"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c181" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;strokeColor=#9673a6;endArrow=open;" edge="1" parent="1" source="c157" target="c158"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c182" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c155" target="c159"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c183" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2640.0" y="2167.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="c184" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c148" target="c183"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c185" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2360.0" y="2917.5" width="40" height="40" as="geometry"/></mxCell><mxCell id="c186" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c159" target="c185"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c187" value="&lt;b&gt;What changed in data handling&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Improved&lt;/b&gt;&lt;br&gt;• Identity from login instead of a typed Source ID; every read filters on owner.&lt;br&gt;• IDs (T-/R- + uuid) and timestamps generated by the app, not typed.&lt;br&gt;• Empty defaults (None) instead of 0 / 0.0 / today.&lt;br&gt;• Validation + confirmation before submit.&lt;br&gt;• Corrections are new linked records (corrects + reason); history shown.&lt;br&gt;• Record page shows curated cards, not a full dump of every file; no device IP collected.&lt;br&gt;&lt;br&gt;&lt;b&gt;Still missing / new gaps&lt;/b&gt;&lt;br&gt;• Nothing persists: session_state only, no JSON, no RDF, no AllegroGraph.&lt;br&gt;• Password is never checked.&lt;br&gt;• New payload shape (title, narrative, topic, corrects, dates) does not match cleaner/mapper (needs record/victim/trafficker IDs) → pipeline would drop every record as-is.&lt;br&gt;• '%-d' date format crashes on Windows.&lt;br&gt;• requirements.txt not carried over." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="3380" y="0" width="430" height="600" as="geometry"/></mxCell><mxCell id="c188" value="Legend" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3380" y="660" width="250" height="30" as="geometry"/></mxCell><mxCell id="c189" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3380" y="700" width="70" height="38" as="geometry"/></mxCell><mxCell id="c190" value="Start / end" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3460" y="700" width="200" height="38" as="geometry"/></mxCell><mxCell id="c191" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="3380" y="748" width="70" height="38" as="geometry"/></mxCell><mxCell id="c192" value="Screen / user interaction" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3460" y="748" width="200" height="38" as="geometry"/></mxCell><mxCell id="c193" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="3380" y="796" width="70" height="38" as="geometry"/></mxCell><mxCell id="c194" value="Processing step" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3460" y="796" width="200" height="38" as="geometry"/></mxCell><mxCell id="c195" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="3380" y="844" width="70" height="38" as="geometry"/></mxCell><mxCell id="c196" value="Decision" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="3460" y="844" width="200" height="38" as="geometry"/></mxCell><mxCell id="c197" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;htm