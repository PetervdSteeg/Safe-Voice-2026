tX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c167" target="c168"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c189" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c168" target="c169"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c190" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c168" target="c170"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c191" value="next file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c169" target="c167"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c192" value="after last file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c170" target="c171"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c193" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c171" target="c172"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c194" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c172" target="c173"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c195" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c173" target="c174"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c196" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c174" target="c175"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c197" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c174" target="c176"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c198" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c175" target="c176"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c199" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c176" target="c177"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c200" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c177" target="c178"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c201" value="&lt;b&gt;Data-handling issues found&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. No authentication: anyone who types a Source ID sees that source's reports.&lt;br&gt;2. Defaults are stored as real data: age 0, lat/lon 0.0, dates = today.&lt;br&gt;3. User-typed IDs go straight into IRIs (case_#2544, victim_123): records from different reports/sources merge if IDs repeat; '#' becomes an IRI fragment.&lt;br&gt;4. Empty Victim ID or Trafficker ID silently drops the whole report (3 of the 5 test reports in the repo).&lt;br&gt;5. CDM type lookup never matches → no type conversion.&lt;br&gt;6. Coordinates rounded only in the RDF; raw/processed JSON and Manage Reports keep exact values.&lt;br&gt;7. Raw JSON is written before the pipeline runs and is never cleaned up on failure.&lt;br&gt;8. Manage Reports dumps every field of every file; failed reports are invisible to the user.&lt;br&gt;9. All sources share AllegroGraph's default graph." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffde7;strokeColor=#c9b458;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1980" y="0" width="420" height="560" as="geometry"/></mxCell><mxCell id="c202" value="Legend" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1980" y="620" width="250" height="30" as="geometry"/></mxCell><mxCell id="c203" value="" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1980" y="660" width="70" height="38" as="geometry"/></mxCell><mxCell id="c204" value="Start / end" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="660" width="200" height="38" as="geometry"/></mxCell><mxCell id="c205" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1980" y="708" width="70" height="38" as="geometry"/></mxCell><mxCell id="c206" value="Screen / user interaction" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="708" width="200" height="38" as="geometry"/></mxCell><mxCell id="c207" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1980" y="756" width="70" height="38" as="geometry"/></mxCell><mxCell id="c208" value="Processing step" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="756" width="200" height="38" as="geometry"/></mxCell><mxCell id="c209" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1980" y="804" width="70" height="38" as="geometry"/></mxCell><mxCell id="c210" value="Decision" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="804" width="200" height="38" as="geometry"/></mxCell><mxCell id="c211" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1980" y="852" width="70" height="38" as="geometry"/></mxCell><mxCell id="c212" value="Error / warning shown" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="852" width="200" height="38" as="geometry"/></mxCell><mxCell id="c213" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1980" y="900" width="70" height="38" as="geometry"/></mxCell><mxCell id="c214" value="Data store / file" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="900" width="200" height="38" as="geometry"/></mxCell><mxCell id="c215" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="1980" y="948" width="70" height="38" as="geometry"/></mxCell><mxCell id="c216" value="Exists but not connected" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="948" width="200" height="38" as="geometry"/></mxCell><mxCell id="c217" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1980" y="996" width="36" height="36" as="geometry"/></mxCell><mxCell id="c218" value="Connector (rerun / jump)" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2030" y="996" width="200" height="36" as="geometry"/></mxCell><mxCell id="c219" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1980" y="1044" width="70" height="38" as="geometry"/></mxCell><mxCell id="c220" value="Red border = issue found in review" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2060" y="1044" width="200" height="38" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>