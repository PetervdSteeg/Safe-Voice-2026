# AllegroGraph Credentials
AG_BASE_URL=allegrograph_base_url
AG_REPO=your_repository_name
AG_USER=your_allegrograph_username
AG_PASSWORD=your_allegrograph_password

# Demo login users (comma-separated username:hash). Generate a hash with: python -m ui.auth
SAFEVOICE_USERS=# Minutes of inactivity before automatic logout (default 30)
# SAFEVOICE_IDLE_MINUTES=30
