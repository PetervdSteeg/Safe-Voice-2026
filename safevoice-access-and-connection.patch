+
+def max_attempts():
+    return _int_env("SAFEVOICE_MAX_ATTEMPTS", 5)
+
+
+def lockout_seconds():
+    return _int_env("SAFEVOICE_LOCKOUT_MINUTES", 15) * 60
+
